# SaasyByte full-stack environment. Copy to .env next to docker-compose.yml.

# Databases (users/passwords of your choosing; databases are created on first run)
CORE_DB_USER=saasy
CORE_DB_PASSWORD=change-me
EDGE_DB_USER=saasy
EDGE_DB_PASSWORD=change-me

# JWT keypair (ES256). Generate:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out private.pem
#   openssl ec -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...contents of private.pem...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...contents of public.pem...
-----END PUBLIC KEY-----"

# Shared secret for saasy-core admin endpoints (X-Admin-Key header)
ADMIN_API_KEY=change-me

# Provider API keys (the orchestrator requires all of them at startup)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
SPEECHMATICS_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# GCP (Vertex): service account JSON content, single line
GCP_PROJECT_ID=
GCP_REGION=global
GCP_SA_JSON=

# AWS (Bedrock)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# IP announced to browsers in WebRTC ICE candidates.
# 127.0.0.1 when the browser runs on this machine; LAN/public IP otherwise.
ANNOUNCED_IP_ADDR=127.0.0.1
